# Backend — modelo de variáveis. Copie para backend/.env em desenvolvimento.
# Em produção, configure estes nomes no painel do host. Nunca commite valores reais.

# String de conexão do MongoDB (use o cluster/banco existente; nada é migrado).
MONGO_URL=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/?retryWrites=true&w=majority
# Nome do banco que a aplicação já usa hoje.
DB_NAME=

# Segredo de assinatura do JWT. Gere um valor longo e aleatório (ex.: openssl rand -hex 32).
JWT_SECRET=

# Administrador criado/atualizado no startup do backend.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origens do frontend autorizadas a chamar a API.
# Lista separada por vírgula, sem barra final. Ex.: https://kop.exemplo.com
CORS_ORIGINS=

# Porta apenas para execução local (`uvicorn server:app --port 8001`).
# Em produção quem define a porta é a variável PORT do host.
PORT=8001
